FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
# Keeps joblib from spawning extra processes inside the container
ENV LOKY_MAX_CPU_COUNT=2

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies in two layers so Docker cache reuses the
# heavier synth layer when only API deps change.
COPY requirements-synth.txt ./requirements-synth.txt
RUN pip install --no-cache-dir -r requirements-synth.txt

COPY requirements-api.txt ./requirements-api.txt
RUN pip install --no-cache-dir -r requirements-api.txt

# Copy source code (models/ is volume-mounted at runtime — not baked in)
COPY src/ ./src/

EXPOSE 8000

CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
